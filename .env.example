PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pb_kecebong
DB_USER=pb
DB_PASSWORD=pb
DB_SSLMODE=disable
JWT_SECRET=change-me-in-production
# Seed password for the initial admin user on a fresh database.
# Set a strong value before first deploy; leaving it empty keeps the
# well-known "admin" fallback with a startup warning.
# ADMIN_DEFAULT_PASSWORD=
CORS_ORIGINS=http://localhost:5173
INACTIVITY_MONTHS=6
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Fallback chain: dipakai berurutan kalau AI sebelumnya gagal
# (rate-limit / auth / network). Label di UI: AI 1 -> AI 2 -> AI 3.
AI_PROVIDER_2=
AI_MODEL_2=
AI_BASE_URL_2=
AI_API_KEY_2=
AI_PROVIDER_3=
AI_MODEL_3=
AI_BASE_URL_3=
AI_API_KEY_3=

# Supabase S3-compatible Storage (for payment proofs)
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=ap-southeast-1
# S3_BUCKET=payment-proofs
# S3_ACCESS_KEY=<supabase-storage-access-key>
# S3_SECRET_KEY=<supabase-storage-secret-key>
# S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/payment-proofs
# Local fallback when S3 is not configured:
UPLOAD_DIR=./uploads
